---
// Base du dépôt, étendue : rendu Plot → SVG au build (route A), avec titre / sous-titre / source facultatifs.
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";
const { options, titre, sous, source } = Astro.props;

const s = Plot.plot({
    ...options,
    document: new JSDOM("").window.document,
}).outerHTML;
const i = s.lastIndexOf("<svg"); // role="img" sur le graphique (une légende éventuelle vient avant)
const svg = s.slice(0, i) + '<svg role="img"' + s.slice(i + 4);
---

{titre && <h3 class="mt-10 mb-1 font-serif text-xl leading-tight">{titre}</h3>}
{sous && <p class="mb-4 max-w-2xl text-brume">{sous}</p>}
<figure
    class="mb-4 overflow-x-auto rounded-xl border border-trait bg-carte p-4 [&_svg]:mx-auto [&_svg]:block [&_svg]:h-auto [&_svg]:max-w-full"
>
    <Fragment set:html={svg} />
    {
        source && (
            <figcaption class="mt-2 text-xs text-brume">{source}</figcaption>
        )
    }
</figure>
