---
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const liens = [
  ["/#contexte", "Contexte"],
  ["/#exploration", "Exploration"],
  ["/#revelation", "Révélation"],
  ["/#conclusion", "Conclusion"],
  ["/methode/", "Méthode"],
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b1a17" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-papier text-[1.0625rem] leading-relaxed text-encre">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:p-2"
      >Aller au contenu</a
    >
    <header class="sticky top-0 z-10 bg-encre text-papier">
      <nav
        aria-label="Principal"
        class="mx-auto flex max-w-4xl items-center gap-5 overflow-x-auto px-5 py-3 text-sm whitespace-nowrap"
      >
        <a href="/" class="mr-auto font-serif text-base font-bold"
          >❄ Neige dans le Doubs</a
        >
        {
          liens.map(([href, texte]) => (
            <a href={href} class="hover:underline">
              {texte}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="border-t border-trait py-8 text-sm">
      <div class="mx-auto max-w-3xl px-5">
        SAE 303 · MMI Montbéliard · Données Météo-France (MENSQ, DRIAS) · <a
          class="text-brique underline"
          href="/methode/">Sources et limites</a
        >
      </div>
    </footer>
  </body>
</html>
